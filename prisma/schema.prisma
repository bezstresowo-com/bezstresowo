generator client {
  provider = "prisma-client"
  output   = "../src/shared/server/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model BlogArticle {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  /// One slug shared by every language version (ideally english):
  /// `/pl/blog/<slug>` and `/uk/blog/<slug>` differ only in the prefix.
  ///
  /// Optional only because the production collection still holds legacy
  /// (pre-i18n) documents without it - they keep the old articles' bucket
  /// files referenced (see `media-cleanup.ts`) and must stay readable.
  /// Every document the app writes has a slug; the admin queries filter on
  /// `slug: { isSet: true }` and uniqueness is asserted in `assertFreeSlug`.
  slug String? @unique

  internationalizedArticles InternationalizedBlogArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InternationalizedBlogArticle {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  lang String

  /// A language version toggled off in the panel is kept (content, media,
  /// SEO fields) and hidden everywhere - never deleted.
  disabled Boolean @default(false)

  title   String
  content String

  /// SEO, kept per language (title ~60 chars, description ~155 chars).
  metaTitle       String
  metaDescription String

  /// Featured image (one of `mediaIds`) plus its localized alt text.
  featuredImageId  String?
  featuredImageAlt String?

  mediaIds       String[]
  metadataJsonLD Json

  blogArticle   BlogArticle @relation(fields: [blogArticleId], references: [id], onDelete: Cascade)
  blogArticleId String      @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blogArticleId, lang])
}

/// Every product lives in our database. Stripe is only ever used to create a
/// checkout session - no products and no prices are stored on Stripe's side.
model Product {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  slug   String  @unique
  active Boolean @default(true)

  /// Where the product shows up: `shop` and/or `registrations`.
  /// Both are always listed on the price list page.
  siteLocations String[]

  /// Optional manual ordering key, falls back to the localized name.
  orderKey String?

  internationalizedProducts InternationalizedProduct[]

  price   Price  @relation(fields: [priceId], references: [id])
  priceId String @unique @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InternationalizedProduct {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  lang String

  name        String
  description String
  mediaIds    String[]

  metadataJsonLD Json

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, lang])
}

model Price {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  currency     String @default("PLN") // ISO 4217
  inMinorUnits Int

  product Product?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Stripe delivers webhook events at least once. Handled event ids are recorded
/// here so a redelivery (after a transient failure and a 500) never sends the
/// notification emails twice.
model ProcessedStripeEvent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  eventId String @unique

  createdAt DateTime @default(now())
}
