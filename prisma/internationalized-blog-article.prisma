model InternationalizedBlogArticle {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  lang String

  /// Per-language URL: `/pl/blog/<slug>` and `/uk/blog/<slug>` are distinct pages.
  slug String @unique

  title   String
  content String

  /// SEO, kept per language (title ~60 chars, description ~155 chars).
  metaTitle       String
  metaDescription String

  /// Featured image (one of `mediaIds`) plus its localized alt text.
  featuredImageId  String?
  featuredImageAlt String?

  mediaIds       String[]
  metadataJsonLD Json

  blogArticle   BlogArticle @relation(fields: [blogArticleId], references: [id], onDelete: Cascade)
  blogArticleId String      @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blogArticleId, lang])
}
