model Product {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  slug String @unique

  // Integer price in grosze (1/100 PLN). Currency is always PLN; Stripe only
  // handles checkout (products are defined here, not in Stripe).
  priceGrosze Int

  active Boolean @default(true)

  internationalizedProducts InternationalizedProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
