# Public
# Cloudflare Turnstile - only read when the captcha is enabled (see below).
PUBLIC_TURNSTILE_SITE_KEY=""

# Contact form captcha switch - set to "true" to render the Turnstile widget
# and verify tokens server side. Requires both Turnstile keys.
PUBLIC_CONTACT_FORM_CAPTCHA_ENABLED="false"

PUBLIC_SITE_URL="" # canonical origin, e.g. https://bezstresowo.org (used for canonical/hreflang/og:image)

# Private
EMAIL_APP_PASSWORD=""
EMAIL_SENDER=""
EMAIL_SUBJECT_PREFIX=""

AWS_S3_ACCESS_KEY_ID=""
AWS_S3_SECRET_ACCESS_KEY=""
AWS_S3_REGION=""
AWS_S3_BUCKET_NAME=""
# Optional - leave empty (or unset) for AWS S3, set to http://localhost:9000 for local MinIO.
AWS_S3_ENDPOINT=""

DATABASE_URL=""

COOKIE_MAX_AGE_S=""

JWT_SECRET=""
JWT_EXP_INTERVAL_MS=""

STRIPE_SK=""
STRIPE_WHSEC=""

# `scrypt:<salt>:<hash>` produced by `node scripts/hash-admin-password.js <password>`.
# A bare sha256 hex of the password is still accepted for backward compatibility.
ADMIN_PASSWORD_HASH=""

CRON_SECRET="" # bearer token for GET/POST /api/cron/media-sweep

# Cloudflare Turnstile - only read when the captcha is enabled.
TURNSTILE_SECRET_KEY=""
